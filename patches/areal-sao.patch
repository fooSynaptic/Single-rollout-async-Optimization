+# SPDX-License-Identifier: Apache-2.0
+"""Unit tests for shared FS sharded reward protocol / client / worker."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import signal
+import time
+from concurrent.futures import ProcessPoolExecutor
+from pathlib import Path
+
+import pytest
+
+from areal.api.cli_args import RewardConfig, FSRewardConfig, FSRewardWorkerConfig
+from areal.api.reward_api import AsyncRewardWrapper, build_async_reward_executor
+from areal.reward.fs_client import RewardInfraError, FSRewardClient
+from areal.reward.fs_protocol import (
+    atomic_write_json,
+    build_result,
+    cleanup_orphans,
+    inbox_path,
+    outbox_path,
+    stable_shard,
+    write_manifest,
+)
+from areal.reward.fs_worker import FSRewardWorker
+
+
+def _dummy_reward(prompt, completions, prompt_ids, completion_ids, answer="4", **kw):
+    return 1.0 if str(answer) in str(completions) else 0.0
+
+
+@pytest.fixture(autouse=True)
+def _isolate_executor_state():
+    AsyncRewardWrapper._atexit_shutdown_all()
+    yield
+    AsyncRewardWrapper._atexit_shutdown_all()
+
+
+class TestProtocol:
+    def test_stable_shard_deterministic(self):
+        assert stable_shard("abc", 2) == stable_shard("abc", 2)
+        shards = {stable_shard(f"id{i}", 2) for i in range(200)}
+        assert shards == {0, 1}
+
+    def test_atomic_write_visible(self, tmp_path: Path):
+        p = tmp_path / "x.json"
+        atomic_write_json(p, {"a": 1})
+        assert json.loads(p.read_text()) == {"a": 1}
+
+    def test_cleanup_orphans(self, tmp_path: Path):
+        write_manifest(tmp_path, {"shard_count": 2, "run_id": "t"})
+        old = inbox_path(tmp_path, 0, "oldtask")
+        atomic_write_json(old, {"task_id": "oldtask"})
+        os.utime(old, (time.time() - 1000, time.time() - 1000))
+        fresh = inbox_path(tmp_path, 0, "newtask")
+        atomic_write_json(fresh, {"task_id": "newtask"})
+        removed = cleanup_orphans(tmp_path, task_ttl_seconds=100)
+        assert removed["inbox"] >= 1
+        assert not old.exists()
+        assert fresh.exists()
+
+
+class TestFactoryLocal:
