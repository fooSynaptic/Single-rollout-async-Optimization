+# SPDX-License-Identifier: Apache-2.0
+"""shared FS sharded reward worker: consume one inbox shard with a bounded process pool."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import resource
+import signal
+import sys
+import threading
+import time
+from collections import deque
+from concurrent.futures import ProcessPoolExecutor, Future
+from pathlib import Path
+from typing import Any
+
+from areal.reward.fs_protocol import (
+    atomic_write_json,
+    build_result,
+    outbox_path,
+    status_path,
+    try_unlink,
+)
+from areal.utils.dynamic_import import import_from_string
+
+# Module-level cache inside pool workers
+_FN_CACHE: dict[str, Any] = {}
+
+
+def _rss_gib() -> float:
+    try:
+        # ru_maxrss: Linux KiB, macOS bytes
+        rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+        if sys.platform == "darwin":
+            return rss / (1024**3)
+        return rss / (1024**2) / 1024.0
+    except Exception:
+        return 0.0
+
+
+def _load_reward_fn(path: str):
+    fn = _FN_CACHE.get(path)
+    if fn is None:
+        fn = import_from_string(path)
+        _FN_CACHE[path] = fn
+    return fn
+
+
+def _run_reward_task(task: dict[str, Any]) -> dict[str, Any]:
+    """Executed inside ProcessPool worker process."""
+    t0 = time.perf_counter()
+    task_id = task["task_id"]
+    try:
+        fn = _load_reward_fn(task["reward_fn"])
+        args = task.get("args") or []
+        kwargs = task.get("kwargs") or {}
+        score = float(fn(*args, **kwargs))
+        verify_ms = (time.perf_counter() - t0) * 1000.0
+        return {
+            "task_id": task_id,
+            "status": "ok",
+            "score": score,
+            "error": None,
+            "verify_ms": verify_ms,
+        }
+    except Exception as e:
+        verify_ms = (time.perf_counter() - t0) * 1000.0
+        return {
+            "task_id": task_id,
+            "status": "error",
+            "score": None,
+            "error": f"{type(e).__name__}: {e}",
+            "verify_ms": verify_ms,
+        }
+
+
+class FSRewardWorker:
+    """Coordinator for one shard on one host."""
+
+    def __init__(
+        self,
+        *,
+        root: str | Path,
+        shard: int,
+        host: str,
+        concurrency: int = 48,
+        scan_interval_s: float = 0.05,
+        max_tasks_per_child: int = 128,
+        task_ttl_seconds: float = 600.0,
+    ):
+        self.root = Path(root)
+        self.shard = shard
+        self.host = host
+        self.concurrency = concurrency
+        self.scan_interval_s = scan_interval_s
+        self.max_tasks_per_child = max_tasks_per_child
+        self.task_ttl_seconds = task_ttl_seconds
+        self.inbox_dir = self.root / "inbox" / str(shard)
+        self._stop = False
+        self._inflight: dict[Future, dict[str, Any]] = {}
+        self._seen: set[str] = set()
+        self._completed = 0
+        self._errors = 0
+        self._semantic_zero = 0
+        self._verify_timeout_n = 0
+        self._q_wait_samples: deque[float] = deque(maxlen=512)
+        self._verify_samples: deque[float] = deque(maxlen=512)
+        self._completed_window: deque[float] = deque()
+        self._pool: ProcessPoolExecutor | None = None
+        self._started_at = time.time()
+
+    def request_stop(self, *_args) -> None:
+        self._stop = True
+
+    def _percentile(self, samples: deque[float], p: float) -> float | None:
+        if not samples:
+            return None
+        arr = sorted(samples)
+        idx = min(len(arr) - 1, max(0, int(round((p / 100.0) * (len(arr) - 1)))))
+        return arr[idx]
+
+    def _write_status(self, ready: bool = True) -> None:
+        now = time.time()
+        # QPS over last ~5s
+        while self._completed_window and now - self._completed_window[0] > 5.0:
+            self._completed_window.popleft()
+        qps = len(self._completed_window) / 5.0
+        pending_files = 0
+        if self.inbox_dir.exists():
+            try:
+                pending_files = sum(1 for _ in self.inbox_dir.glob("*.json"))
+            except OSError:
+                pending_files = -1
+        payload = {
+            "host": self.host,
+            "shard": self.shard,
+            "ready": ready and not self._stop,
+            "heartbeat_at": now,
+            "started_at": self._started_at,
+            "pid": os.getpid(),
+            "concurrency": self.concurrency,
+            "inflight": len(self._inflight),
+            "queue_depth": pending_files,
+            "qps": qps,
+            "completed": self._completed,
+            "errors": self._errors,
+            "semantic_zero": self._semantic_zero,
+            "verify_timeout_n": self._verify_timeout_n,
+            "queue_wait_ms_p50": self._percentile(self._q_wait_samples, 50),
+            "queue_wait_ms_p95": self._percentile(self._q_wait_samples, 95),
+            "verify_ms_p50": self._percentile(self._verify_samples, 50),
+            "verify_ms_p95": self._percentile(self._verify_samples, 95),
+            "rss_gib": _rss_gib(),
+        }
+        atomic_write_json(status_path(self.root, self.host), payload)
+
+    def _ensure_pool(self) -> ProcessPoolExecutor:
+        if self._pool is not None:
+            return self._pool
+        pool_kwargs: dict[str, Any] = {"max_workers": self.concurrency}
+        if sys.version_info >= (3, 11):
+            pool_kwargs["max_tasks_per_child"] = self.max_tasks_per_child
+        self._pool = ProcessPoolExecutor(**pool_kwargs)
+        return self._pool
+
+    def _recreate_pool(self) -> None:
+        if self._pool is not None:
+            try:
+                self._pool.shutdown(wait=False, cancel_futures=True)
+            except Exception:
+                pass
+            self._pool = None
+        self._inflight.clear()
+        self._ensure_pool()
+
+    def _submit_path(self, path: Path) -> None:
+        if len(self._inflight) >= self.concurrency:
+            return
+        try:
+            with path.open("r", encoding="utf-8") as f:
+                task = json.load(f)
+        except (OSError, json.JSONDecodeError) as e:
+            task_id = path.stem
+            result = build_result(
+                task_id=task_id,
+                status="error",
+                error=f"bad_inbox_json: {e}",
+                worker_host=self.host,
+                shard=self.shard,
+            )
+            atomic_write_json(outbox_path(self.root, task_id), result)
+            try_unlink(path)
+            self._errors += 1
+            return
+
+        task_id = task.get("task_id") or path.stem
+        if task_id in self._seen:
+            return
+        created = float(task.get("created_at", time.time()))
+        meta = {
+            "task_id": task_id,
+            "inbox_path": path,
+            "created_at": created,
+            "submit_at_wall": time.time(),
+        }
+        pool = self._ensure_pool()
+        try:
+            fut = pool.submit(_run_reward_task, task)
+        except Exception as e:
+            # BrokenProcessPool etc. — recreate and retry once
+            self._recreate_pool()
+            try:
+                fut = self._ensure_pool().submit(_run_reward_task, task)
+            except Exception as e2:
+                result = build_result(
+                    task_id=task_id,
+                    status="error",
+                    error=f"submit_failed: {type(e2).__name__}: {e2}",
+                    worker_host=self.host,
+                    shard=self.shard,
+                )
+                atomic_write_json(outbox_path(self.root, task_id), result)
+                try_unlink(path)
+                self._errors += 1
+                return
+        self._inflight[fut] = meta
+        self._seen.add(task_id)
+
+    def _drain_done(self) -> None:
+        done = [f for f in list(self._inflight) if f.done()]
+        for fut in done:
+            # After BrokenProcessPool → _recreate_pool(), _inflight is cleared;
+            # never KeyError on a sibling Future that was already wiped.
+            meta = self._inflight.pop(fut, None)
+            if meta is None:
+                continue
+            task_id = meta["task_id"]
+            queue_wait_ms = max(
+                0.0, (meta["submit_at_wall"] - meta["created_at"]) * 1000.0
+            )
+            pool_broke = False
+            try:
+                out = fut.result()
+            except Exception as e:
+                out = {
+                    "task_id": task_id,
+                    "status": "error",
+                    "score": None,
+                    "error": f"{type(e).__name__}: {e}",
+                    "verify_ms": None,
+                }
+                ename = type(e).__name__
+                if ename == "BrokenProcessPool" or "BrokenProcessPool" in str(e):
+                    pool_broke = True
+                    self._recreate_pool()
+            status = out.get("status", "error")
+            score = out.get("score")
+            verify_ms = out.get("verify_ms")
+            if verify_ms is not None:
+                self._verify_samples.append(float(verify_ms))
+            self._q_wait_samples.append(float(queue_wait_ms))
+            total_ms = queue_wait_ms + (float(verify_ms) if verify_ms else 0.0)
+            result = build_result(
+                task_id=task_id,
+                status=status,
+                score=float(score) if score is not None else None,
+                error=out.get("error"),
+                queue_wait_ms=queue_wait_ms,
+                verify_ms=verify_ms,
+                total_ms=total_ms,
+                worker_host=self.host,
+                shard=self.shard,
+            )
+            atomic_write_json(outbox_path(self.root, task_id), result)
+            try_unlink(meta["inbox_path"])
+            if status == "ok":
+                self._completed += 1
+                self._completed_window.append(time.time())
+                if float(score or 0.0) == 0.0:
+                    self._semantic_zero += 1
+            else:
+                self._errors += 1
+            if len(self._seen) > 50000:
+                self._seen.clear()
+            # Pool was recreated and inflight cleared — stop draining stale Futures.
+            if pool_broke:
+                return
+
+    def run(self) -> None:
+        self.inbox_dir.mkdir(parents=True, exist_ok=True)
+        (self.root / "outbox").mkdir(parents=True, exist_ok=True)
+        (self.root / "status").mkdir(parents=True, exist_ok=True)
+
+        self._ensure_pool()
+
+        # SIGTERM only works in the main thread (production ctl starts main).
+        if threading.current_thread() is threading.main_thread():
+            signal.signal(signal.SIGTERM, self.request_stop)
+            signal.signal(signal.SIGINT, self.request_stop)
+
+        self._write_status(ready=True)
+        last_status = 0.0
+        try:
+            while not self._stop:
+                self._drain_done()
+                if len(self._inflight) < self.concurrency and self.inbox_dir.exists():
+                    try:
+                        paths = sorted(
+                            self.inbox_dir.glob("*.json"),
+                            key=lambda p: p.stat().st_mtime,
+                        )
+                    except OSError:
+                        paths = []
+                    for path in paths:
+                        if self._stop:
+                            break
+                        if len(self._inflight) >= self.concurrency:
+                            break
+                        self._submit_path(path)
+                now = time.time()
+                if now - last_status >= 1.0:
+                    self._write_status(ready=True)
+                    last_status = now
+                time.sleep(self.scan_interval_s)
+
+            grace_deadline = time.time() + 30.0
+            while self._inflight and time.time() < grace_deadline:
+                self._drain_done()
+                time.sleep(0.05)
+            self._write_status(ready=False)
+        finally:
+            if self._pool is not None:
+                self._pool.shutdown(wait=False, cancel_futures=True)
+                self._pool = None
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="shared FS sharded reward worker")
+    parser.add_argument("--root", required=True, help="Absolute shared FS run root")
+    parser.add_argument("--shard", type=int, required=True)
+    parser.add_argument("--host", required=True, help="Hostname label for status file")
+    parser.add_argument("--concurrency", type=int, default=48)
+    parser.add_argument("--scan-interval-ms", type=float, default=50.0)
+    parser.add_argument("--max-tasks-per-child", type=int, default=128)
+    args = parser.parse_args(argv)
+
+    # Forbid running consumer on head by convention (soft check)
+    host_env = os.environ.get("HOSTNAME", "") or os.environ.get("HOST", "")
+    if "head" in (args.host, host_env):
+        print(
+            "ERROR: reward consumer must not run on head",
+            file=sys.stderr,
+        )
+        return 2
+
+    worker = FSRewardWorker(
+        root=args.root,
+        shard=args.shard,
+        host=args.host,
+        concurrency=args.concurrency,
+        scan_interval_s=args.scan_interval_ms / 1000.0,
+        max_tasks_per_child=args.max_tasks_per_child,
+    )
+    print(
+        f"[reward_worker] host={args.host} shard={args.shard} "
+        f"concurrency={args.concurrency} root={args.root}",
+        flush=True,
+    )
+    worker.run()
+    print("[reward_worker] stopped", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
