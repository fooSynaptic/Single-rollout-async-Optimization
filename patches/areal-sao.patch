+        ex = build_async_reward_executor(_dummy_reward, cfg)
+        assert await ex("p", "nope", [], [], answer="4") == 0.0
+
+    def test_fs_requires_string(self):
+        cfg = RewardConfig(backend="fs_shard")
+        with pytest.raises(TypeError):
+            build_async_reward_executor(_dummy_reward, cfg)
+
+
+class Testshared FSClientWorker:
+    @pytest.mark.asyncio
+    async def test_end_to_end_two_shards(self, tmp_path: Path):
+        import subprocess
+        import sys
+
+        write_manifest(
+            tmp_path,
+            {
+                "shard_count": 2,
+                "run_id": "ut",
+                "reward_fn": "areal.reward.simple_answer.simple_answer_reward_fn",
+            },
+        )
+        procs = []
+        for shard, host in ((0, "worker-0"), (1, "worker-1")):
+            p = subprocess.Popen(
+                [
+                    sys.executable,
+                    "-m",
+                    "areal.reward.fs_worker",
+                    "--root",
+                    str(tmp_path),
+                    "--shard",
+                    str(shard),
+                    "--host",
+                    host,
+                    "--concurrency",
+                    "2",
+                ],
+                stdout=subprocess.DEVNULL,
+                stderr=subprocess.DEVNULL,
+            )
+            procs.append(p)
+
+        try:
+            deadline = time.time() + 20
+            while time.time() < deadline:
+                ok = True
+                for host in ("worker-0", "worker-1"):
+                    p = tmp_path / "status" / f"{host}.json"
+                    if not p.exists() or not json.loads(p.read_text()).get("ready"):
+                        ok = False
+                        break
+                if ok:
+                    break
+                await asyncio.sleep(0.05)
+            else:
+                raise AssertionError("workers not ready")
+
+            client = FSRewardClient(
+                "areal.reward.simple_answer.simple_answer_reward_fn",
+                root=tmp_path,
+                shard_count=2,
+                timeout_seconds=30,
+                poll_interval_ms=20,
+                on_error="raise",
+                worker_hosts=["worker-0", "worker-1"],
+            )
+
+            scores = await asyncio.gather(
+                *[
+                    client("q", f"The answer is {i}", [], [], answer=str(i))
+                    for i in range(8)
+                ]
+            )
+            assert all(s == 1.0 for s in scores)
+
+            zeros = await asyncio.gather(
+                *[
+                    client("q", "The answer is 0", [], [], answer="99")
+                    for _ in range(4)
+                ]
+            )
+            assert all(z == 0.0 for z in zeros)
+        finally:
+            for p in procs:
+                p.send_signal(signal.SIGTERM)
+            for p in procs:
+                p.wait(timeout=15)
+
+    @pytest.mark.asyncio
+    async def test_timeout_fail_fast(self, tmp_path: Path):
+        write_manifest(tmp_path, {"shard_count": 2, "run_id": "t"})
+        for host in ("worker-0", "worker-1"):
+            atomic_write_json(
+                tmp_path / "status" / f"{host}.json",
+                {"ready": True, "heartbeat_at": time.time(), "host": host},
+            )
+        client = FSRewardClient(
+            "areal.reward.gsm8k.gsm8k_reward_fn",
+            root=tmp_path,
+            shard_count=2,
+            timeout_seconds=0.2,
+            poll_interval_ms=20,
+            on_error="raise",
+            worker_hosts=["worker-0", "worker-1"],
+        )
+        with pytest.raises(RewardInfraError):
+            await client("q", "4", [], [], answer="4")
+
+    @pytest.mark.asyncio
+    async def test_on_error_zero(self, tmp_path: Path):
+        write_manifest(tmp_path, {"shard_count": 2, "run_id": "t"})
+        for host in ("worker-0", "worker-1"):
+            atomic_write_json(
+                tmp_path / "status" / f"{host}.json",
+                {"ready": True, "heartbeat_at": time.time(), "host": host},
+            )
+        client = FSRewardClient(
+            "areal.reward.gsm8k.gsm8k_reward_fn",
+            root=tmp_path,
+            shard_count=2,
+            timeout_seconds=0.15,
+            on_error="zero",
+            worker_hosts=["worker-0", "worker-1"],
+        )
+        assert await client("q", "4", [], [], answer="4") == 0.0
+        assert client.stats["infra_error"] >= 1
+
+    def test_duplicate_task_id_idempotent_result(self, tmp_path: Path):
+        write_manifest(tmp_path, {"shard_count": 1, "run_id": "t"})
+        tid = "sameid"
+        atomic_write_json(
+            outbox_path(tmp_path, tid),
+            build_result(task_id=tid, status="ok", score=1.0),
+        )
+        # second write overwrites atomically — last wins
+        atomic_write_json(
+            outbox_path(tmp_path, tid),
+            build_result(task_id=tid, status="ok", score=1.0),
+        )
+        assert json.loads(outbox_path(tmp_path, tid).read_text())["score"] == 1.0
