+# SPDX-License-Identifier: Apache-2.0
+"""Unit tests for shared FS reward worker BrokenProcessPool drain fix (issue 20260724)."""
+
+from __future__ import annotations
+
+from concurrent.futures import Future
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+from areal.reward.fs_worker import FSRewardWorker
+
+
+class _BrokenFut:
+    """Minimal Future-like object that is done and raises BrokenProcessPool."""
+
+    def __init__(self, err: BaseException):
+        self._err = err
+
+    def done(self) -> bool:
+        return True
+
+    def result(self):
+        raise self._err
+
+
+def test_drain_done_broken_pool_does_not_keyerror(tmp_path: Path):
+    # concurrent.futures.process.BrokenProcessPool
+    from concurrent.futures.process import BrokenProcessPool
+
+    w = FSRewardWorker(
+        root=tmp_path,
+        shard=0,
+        host="worker-0",
+        concurrency=4,
+    )
+    (tmp_path / "outbox").mkdir(parents=True, exist_ok=True)
+    (tmp_path / "inbox" / "0").mkdir(parents=True, exist_ok=True)
+
+    inbox_a = tmp_path / "inbox" / "0" / "a.json"
+    inbox_b = tmp_path / "inbox" / "0" / "b.json"
+    inbox_a.write_text("{}")
+    inbox_b.write_text("{}")
+
+    fut1 = _BrokenFut(BrokenProcessPool("pool dead"))
+    fut2 = _BrokenFut(BrokenProcessPool("pool dead"))
+    w._inflight[fut1] = {  # type: ignore[index]
+        "task_id": "a",
+        "inbox_path": inbox_a,
+        "created_at": 1.0,
+        "submit_at_wall": 1.1,
+    }
+    w._inflight[fut2] = {  # type: ignore[index]
+        "task_id": "b",
+        "inbox_path": inbox_b,
+        "created_at": 1.0,
+        "submit_at_wall": 1.1,
+    }
+
+    # Should not raise KeyError; should clear/recreate and return.
+    w._recreate_pool = MagicMock(wraps=w._recreate_pool)  # type: ignore[method-assign]
+    w._drain_done()
+    assert w._recreate_pool.called
+    # After recreate, inflight must be empty (no leftover stale futures).
+    assert w._inflight == {}
+    # First task should have an outbox error written
+    assert (tmp_path / "outbox" / "a.json").exists()
+
+
+def test_drain_done_pop_missing_is_safe(tmp_path: Path):
+    w = FSRewardWorker(root=tmp_path, shard=0, host="worker-0", concurrency=2)
+    (tmp_path / "outbox").mkdir(parents=True, exist_ok=True)
+    # empty inflight — drain is no-op
+    w._drain_done()
+    assert w._inflight == {}
