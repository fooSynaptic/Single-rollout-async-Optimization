+def build_async_reward_executor(
+    reward_fn: Callable[..., Any] | str,
+    reward_config: Any | None = None,
+):
+    """Factory for local ProcessPool or shared FS sharded reward executors.
+
+    Parameters
+    ----------
+    reward_fn:
+        Callable or import-path string. shared FS backend requires a string.
+    reward_config:
+        ``RewardConfig`` instance or None (defaults to local backend).
+    """
+    backend = "local"
+    timeout_seconds = 15.0
+    max_retries = 3
+    max_workers = None
+    on_error = "raise"
+    fs = None
+    if reward_config is not None:
+        backend = getattr(reward_config, "backend", "local")
+        timeout_seconds = float(getattr(reward_config, "timeout_seconds", 15.0))
+        max_retries = int(getattr(reward_config, "max_retries", 3))
+        max_workers = getattr(reward_config, "max_workers", None)
+        on_error = getattr(reward_config, "on_error", "raise")
+        fs = getattr(reward_config, "fs_shard", None)
+
+    if backend in (None, "local"):
+        if isinstance(reward_fn, str):
+            from areal.utils.dynamic_import import import_from_string
+
+            reward_fn = import_from_string(reward_fn)
+        return AsyncRewardWrapper(
+            reward_fn,
+            timeout_seconds=timeout_seconds,
+            max_workers=max_workers,
+            max_retries=max_retries,
+        )
+
+    if backend == "fs_shard":
+        if not isinstance(reward_fn, str):
+            raise TypeError(
+                "backend=fs_shard requires reward_fn as an import path string "
+                "(callables are not sent over shared FS)"
+            )
+        if fs is None:
+            raise ValueError(
+                "reward.fs_shard config is required for backend=fs_shard"
+            )
+        from areal.reward.fs_client import FSRewardClient
+
+        root_str = str(getattr(fs, "root"))
+        workers = list(getattr(fs, "workers", []) or [])
+        hosts = []
+        for w in workers:
+            if isinstance(w, dict):
+                h = w.get("host")
+            else:
+                h = getattr(w, "host", None)
+            if h:
+                hosts.append(h)
+        return FSRewardClient(
+            reward_fn,
+            root=root_str,
+            shard_count=int(getattr(fs, "shard_count", 2)),
+            timeout_seconds=timeout_seconds,
+            poll_interval_ms=float(getattr(fs, "poll_interval_ms", 50.0)),
+            on_error=on_error,
+            heartbeat_stale_seconds=float(
+                getattr(fs, "heartbeat_stale_seconds", 15.0)
+            ),
+            worker_hosts=hosts,
+        )
+
+    raise ValueError(f"Unknown reward.backend={backend!r}; use 'local' or 'fs_shard'")
