new file mode 100644
index 0000000..679eec4
--- /dev/null
+++ b/areal/reward/fs_client.py
@@ -0,0 +1,205 @@
+# SPDX-License-Identifier: Apache-2.0
+"""shared FS sharded reward client: submit task files and poll results."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+from pathlib import Path
+from typing import Any
+
+from areal.reward.fs_protocol import (
+    atomic_write_json,
+    build_task,
+    inbox_path,
+    json_safe,
+    new_task_id,
+    outbox_path,
+    read_manifest,
+    stable_shard,
+    status_path,
+    try_unlink,
+)
+from areal.utils import logging
+
+logger = logging.getLogger("FSRewardClient")
+
+
+class RewardInfraError(RuntimeError):
+    """Infrastructure failure for shared FS reward (not a semantic score=0)."""
+
+
+class FSRewardClient:
+    """Async reward executor that offloads verify to remote shared FS workers.
+
+    Does **not** create a local ProcessPool. Call signature matches
+    ``AsyncRewardWrapper``: ``await client(prompt, completions, ...)``.
+    """
+
+    def __init__(
+        self,
+        reward_fn: str,
+        *,
+        root: str | Path,
+        shard_count: int = 2,
+        timeout_seconds: float = 30.0,
+        poll_interval_ms: float = 50.0,
+        on_error: str = "raise",
+        heartbeat_stale_seconds: float = 15.0,
+        worker_hosts: list[str] | None = None,
+    ):
+        if not isinstance(reward_fn, str) or not reward_fn:
+            raise TypeError(
+                "FSRewardClient requires reward_fn as import path string, "
+                f"got {type(reward_fn)!r}"
+            )
+        if on_error not in ("raise", "zero"):
+            raise ValueError(f"on_error must be 'raise' or 'zero', got {on_error!r}")
+        self.reward_fn = reward_fn
+        self.root = Path(root)
+        self.shard_count = shard_count
+        self.timeout_seconds = timeout_seconds
+        self.poll_interval = poll_interval_ms / 1000.0
+        self.on_error = on_error
+        self.heartbeat_stale_seconds = heartbeat_stale_seconds
+        self.worker_hosts = worker_hosts or []
+        self._manifest_checked = False
+        self.stats = {
+            "submitted": 0,
+            "completed": 0,
+            "infra_error": 0,
+            "semantic_zero": 0,
+            "queue_wait_ms_sum": 0.0,
+            "total_ms_sum": 0.0,
+        }
+
+    def _ensure_manifest(self) -> None:
+        if self._manifest_checked:
+            return
+        manifest_path = self.root / "manifest.json"
+        if not manifest_path.exists():
+            raise RewardInfraError(
+                f"shared FS reward manifest missing at {manifest_path}; "
+                "start reward workers before training"
+            )
+        manifest = read_manifest(self.root)
+        if int(manifest.get("shard_count", 0)) != self.shard_count:
+            raise RewardInfraError(
+                f"shard_count mismatch: client={self.shard_count} "
+                f"manifest={manifest.get('shard_count')}"
+            )
+        self._manifest_checked = True
+
+    def _check_heartbeats(self) -> None:
+        if not self.worker_hosts:
+            return
+        now = time.time()
+        for host in self.worker_hosts:
+            path = status_path(self.root, host)
+            if not path.exists():
+                raise RewardInfraError(f"reward worker heartbeat missing: {host}")
+            try:
+                with path.open("r", encoding="utf-8") as f:
+                    st = json.load(f)
+            except (OSError, json.JSONDecodeError) as e:
+                raise RewardInfraError(f"bad heartbeat for {host}: {e}") from e
+            hb = float(st.get("heartbeat_at", 0))
+            if now - hb > self.heartbeat_stale_seconds:
+                raise RewardInfraError(
+                    f"reward worker heartbeat stale: {host} "
+                    f"age={now - hb:.1f}s > {self.heartbeat_stale_seconds}s"
+                )
+            if st.get("ready") is False:
+                raise RewardInfraError(f"reward worker not ready: {host}")
+
+    def _handle_infra(self, msg: str) -> float:
+        self.stats["infra_error"] += 1
+        logger.error("shared FS reward infra error: %s", msg)
+        if self.on_error == "zero":
+            return 0.0
+        raise RewardInfraError(msg)
+
+    async def __call__(self, *args: Any, **kwargs: Any) -> float:
+        t0 = time.perf_counter()
+        try:
+            self._ensure_manifest()
+            self._check_heartbeats()
+            safe_args = json_safe(list(args))
+            # Strip non-JSON / oversized fields commonly present in task_data
+            clean_kwargs = {
+                k: v
+                for k, v in kwargs.items()
+                if k
+                not in (
+                    "messages",
+                    "prompt_ids",
+                    "completion_ids",
+                    "input_ids",
+                    "output_ids",
+                )
+            }
+            # Keep answer and other scalar fields; drop nested tensors etc.
+            safe_kwargs = {}
+            for k, v in clean_kwargs.items():
+                try:
+                    safe_kwargs[k] = json_safe(v)
+                except TypeError:
+                    continue
+            # Positional: prompt, completions, prompt_ids, completion_ids
+            # Workers only need completions + answer for gsm8k; keep args truncated
+            submit_args: list[Any] = []
+            if len(safe_args) >= 2:
+                submit_args = [safe_args[0], safe_args[1], [], []]
+            else:
+                submit_args = safe_args
+
+            task_id = new_task_id()
+            shard = stable_shard(task_id, self.shard_count)
+            task = build_task(
+                task_id=task_id,
+                reward_fn=self.reward_fn,
+                args=submit_args,
+                kwargs=safe_kwargs,
+            )
+            in_path = inbox_path(self.root, shard, task_id)
+            out_path = outbox_path(self.root, task_id)
+            atomic_write_json(in_path, task)
+            self.stats["submitted"] += 1
+        except RewardInfraError as e:
+            return self._handle_infra(str(e))
+        except Exception as e:
+            return self._handle_infra(f"submit failed: {e}")
+
+        deadline = t0 + self.timeout_seconds
+        while True:
+            if out_path.exists():
+                try:
+                    with out_path.open("r", encoding="utf-8") as f:
+                        result = json.load(f)
+                except (OSError, json.JSONDecodeError) as e:
+                    try_unlink(out_path)
+                    return self._handle_infra(f"bad result file {out_path}: {e}")
+                try_unlink(out_path)
+                status = result.get("status")
+                if status == "ok":
+                    score = float(result.get("score", 0.0))
+                    self.stats["completed"] += 1
+                    if score == 0.0:
+                        self.stats["semantic_zero"] += 1
+                    qw = result.get("queue_wait_ms")
+                    if qw is not None:
+                        self.stats["queue_wait_ms_sum"] += float(qw)
+                    self.stats["total_ms_sum"] += (time.perf_counter() - t0) * 1000.0
+                    return score
+                err = result.get("error") or f"status={status}"
+                return self._handle_infra(f"task {task_id} failed: {err}")
+
+            if time.perf_counter() >= deadline:
+                try_unlink(in_path)
+                try_unlink(out_path)
+                return self._handle_infra(
+                    f"timeout waiting outbox for {task_id} "
+                    f"after {self.timeout_seconds}s"
+                )
+            await asyncio.sleep(self.poll_interval)
diff --git a/areal/reward/fs_protocol.py b/areal/reward/fs_protocol.py
new file mode 100644
index 0000000..d58f41e
--- /dev/null
+++ b/areal/reward/fs_protocol.py
@@ -0,0 +1,213 @@
+# SPDX-License-Identifier: Apache-2.0
+"""shared FS sharded reward file protocol (inbox/outbox, no RPC)."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import time
+import uuid
+from pathlib import Path
+from typing import Any
+
+SCHEMA_VERSION = 1
+DEFAULT_ROOT_PREFIX = "${REWARD_ROOT}"
+
+
+def stable_shard(task_id: str, shard_count: int) -> int:
+    if shard_count <= 0:
+        raise ValueError(f"shard_count must be > 0, got {shard_count}")
+    digest = hashlib.blake2b(task_id.encode("utf-8"), digest_size=8).digest()
+    return int.from_bytes(digest, "big") % shard_count
+
+
+def new_task_id() -> str:
+    return uuid.uuid4().hex
+
+
+def run_root(
+    root: str,
+    experiment_name: str | None = None,
+    trial_name: str | None = None,
+    run_id: str | None = None,
+) -> Path:
+    """Resolve absolute run root.
+
+    If ``root`` already points at a concrete run directory (contains
+    ``manifest.json`` or ends with a run_id), return it as-is. Otherwise
+    append ``experiment/trial/run_id`` under the given prefix.
+    """
+    p = Path(root)
+    if (p / "manifest.json").exists() or (p / "inbox").exists():
+        return p
+    if run_id and experiment_name and trial_name:
+        return p / experiment_name / trial_name / run_id
+    return p
+
+
+def ensure_run_dirs(root: Path, shard_count: int) -> None:
+    root.mkdir(parents=True, exist_ok=True)
+    (root / "inbox").mkdir(exist_ok=True)
+    (root / "outbox").mkdir(exist_ok=True)
+    (root / "status").mkdir(exist_ok=True)
+    (root / "ctl").mkdir(exist_ok=True)
+    for shard in range(shard_count):
+        (root / "inbox" / str(shard)).mkdir(exist_ok=True)
+
+
+def write_manifest(root: Path, payload: dict[str, Any]) -> Path:
+    ensure_run_dirs(root, int(payload.get("shard_count", 2)))
+    data = {
+        "schema_version": SCHEMA_VERSION,
+        "created_at": time.time(),
+        **payload,
+    }
+    path = root / "manifest.json"
+    atomic_write_json(path, data)
+    return path
+
+
+def read_manifest(root: Path) -> dict[str, Any]:
+    path = root / "manifest.json"
+    with path.open("r", encoding="utf-8") as f:
+        return json.load(f)
+
+
+def inbox_path(root: Path, shard: int, task_id: str) -> Path:
+    return root / "inbox" / str(shard) / f"{task_id}.json"
+
+
+def outbox_path(root: Path, task_id: str) -> Path:
+    return root / "outbox" / f"{task_id}.json"
+
+
+def status_path(root: Path, host: str) -> Path:
+    return root / "status" / f"{host}.json"
+
+
+def atomic_write_bytes(path: Path, data: bytes) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
+    try:
+        with tmp.open("wb") as f:
+            f.write(data)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+    finally:
+        if tmp.exists():
+            try:
+                tmp.unlink()
+            except OSError:
+                pass
+
+
+def atomic_write_text(path: Path, text: str) -> None:
+    atomic_write_bytes(path, text.encode("utf-8"))
+
+
+def atomic_write_json(path: Path, obj: dict[str, Any]) -> None:
+    atomic_write_text(path, json.dumps(obj, ensure_ascii=False, separators=(",", ":")))
+
+
+def build_task(
+    *,
+    task_id: str,
+    reward_fn: str,
+    args: list[Any],
+    kwargs: dict[str, Any],
+) -> dict[str, Any]:
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "task_id": task_id,
+        "reward_fn": reward_fn,
+        "args": args,
+        "kwargs": kwargs,
+        "created_at": time.time(),
+    }
+
+
+def build_result(
+    *,
+    task_id: str,
+    status: str,
+    score: float | None = None,
+    error: str | None = None,
+    queue_wait_ms: float | None = None,
+    verify_ms: float | None = None,
+    total_ms: float | None = None,
+    worker_host: str | None = None,
+    shard: int | None = None,
+) -> dict[str, Any]:
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "task_id": task_id,
+        "status": status,  # ok | error | timeout
+        "score": score,
+        "error": error,
+        "queue_wait_ms": queue_wait_ms,
+        "verify_ms": verify_ms,
+        "total_ms": total_ms,
+        "worker_host": worker_host,
+        "shard": shard,
+        "finished_at": time.time(),
+    }
+
+
+def json_safe(obj: Any) -> Any:
+    """Ensure payload is JSON-serializable; raise TypeError otherwise."""
+    if obj is None or isinstance(obj, (bool, int, float, str)):
+        return obj
+    if isinstance(obj, (list, tuple)):
+        return [json_safe(x) for x in obj]
+    if isinstance(obj, dict):
+        out = {}
+        for k, v in obj.items():
+            if not isinstance(k, str):
+                raise TypeError(f"non-string kwargs key: {k!r}")
+            out[k] = json_safe(v)
+        return out
+    raise TypeError(f"not JSON-serializable: {type(obj).__name__}")
+
+
+def try_unlink(path: Path) -> None:
+    try:
+        path.unlink(missing_ok=True)
+    except OSError:
+        pass
+
+
+def cleanup_orphans(
+    root: Path,
+    *,
+    task_ttl_seconds: float = 600.0,
+    now: float | None = None,
+) -> dict[str, int]:
+    """Remove stale inbox/outbox files older than TTL. Hot path should not call this."""
+    now = time.time() if now is None else now
+    removed = {"inbox": 0, "outbox": 0}
+    inbox = root / "inbox"
+    if inbox.exists():
+        for shard_dir in inbox.iterdir():
+            if not shard_dir.is_dir():
+                continue
+            for path in shard_dir.glob("*.json"):
+                try:
+                    age = now - path.stat().st_mtime
+                except OSError:
+                    continue
+                if age > task_ttl_seconds:
+                    try_unlink(path)
+                    removed["inbox"] += 1
+    outbox = root / "outbox"
+    if outbox.exists():
+        for path in outbox.glob("*.json"):
+            try:
+                age = now - path.stat().st_mtime
+            except OSError:
+                continue
+            if age > task_ttl_seconds:
+                try_unlink(path)
+                removed["outbox"] += 1
+    return removed
